# ==================================================================================
# agda-lattices: .gitignore
# ==================================================================================

# -- Editor and OS -----------------------------------------------------------------
*~
.#*
\#*\#
.DS_Store
*.swp
*.swo
.vscode/
.idea/

# -- Agda build artifacts ----------------------------------------------------------
*.agdai
_build/
# The generated module index (regenerated by the Makefile).
src/EverythingLattices.agda

# -- Nix and the agda-algebras dependency ------------------------------------------
# Project-local AGDA_DIR (written fresh by `nix develop`).
/.agda/
# The writable copy of the pinned agda-algebras source (written by `nix develop`).
/.deps/
/result
/result-*
.direnv/

# -- Merge-conflict leftovers ------------------------------------------------------
*.orig
